msgid "Vacanza"
msgstr "Vacaciones"

msgid "Famiglia"
msgstr "Familia"

msgid "Gruppo o parrocchia"
msgstr "Grupo o parroquia"

msgid "Ritiro spirituale"
msgstr "Retiro espiritual"

msgctxt "formato data email"
msgid "j F Y"
msgstr "j \\d\\e F \\d\\e Y"

msgid "Scegli la data di arrivo."
msgstr "Elige la fecha de llegada."

msgid "La data di arrivo è già passata."
msgstr "La fecha de llegada ya ha pasado."

msgid "Scegli la data di partenza."
msgstr "Elige la fecha de salida."

msgid "La partenza deve essere dopo l’arrivo."
msgstr "La salida debe ser posterior a la llegada."

msgid "Per soggiorni oltre 120 notti scrivi direttamente alla casa."
msgstr "Para estancias de más de 120 noches, escribe directamente a la casa."

msgid "Indica da 1 a 120 adulti."
msgstr "Indica de 1 a 120 adultos."

msgid "Indica da 0 a 60 bambini."
msgstr "Indica de 0 a 60 niños."

msgid "Scrivi nome e cognome."
msgstr "Escribe tu nombre y apellidos."

msgid "Controlla l’indirizzo email (es. nome@esempio.it)."
msgstr "Revisa la dirección de correo (p. ej. nombre@ejemplo.es)."

msgid "Serve il consenso per inviare la richiesta."
msgstr "Necesitamos tu consentimiento para enviar la solicitud."

msgid "Richiesta inviata."
msgstr "Solicitud enviada."

msgid "Hai inviato molte richieste in poco tempo. Riprova tra qualche minuto o scrivi direttamente alla casa."
msgstr "Has enviado muchas solicitudes en poco tiempo. Vuelve a intentarlo dentro de unos minutos o escribe directamente a la casa."

msgid "Struttura non trovata. Ricarica la pagina e riprova."
msgstr "Casa no encontrada. Recarga la página y vuelve a intentarlo."

msgid "Questa casa non riceve ancora richieste dal sito: usa i recapiti indicati nella pagina."
msgstr "Esta casa todavía no recibe solicitudes desde la web: usa los datos de contacto indicados en la página."

msgid "Manca un’informazione: la trovi evidenziata."
msgstr "Falta un dato: lo verás resaltado."

msgid "Mancano %d informazioni: le trovi evidenziate."
msgstr "Faltan %d datos: los verás resaltados."

msgid "%d adulto"
msgid_plural "%d adulti"
msgstr[0] "%d adulto"
msgstr[1] "%d adultos"

msgid "%d bambino"
msgid_plural "%d bambini"
msgstr[0] "%d niño"
msgstr[1] "%d niños"

msgid "%d notte"
msgid_plural "%d notti"
msgstr[0] "%d noche"
msgstr[1] "%d noches"

msgid "Struttura: %s"
msgstr "Casa: %s"

msgid "Date: %s"
msgstr "Fechas: %s"

msgid "Partecipanti: %s"
msgstr "Participantes: %s"

msgid "Camera: %s"
msgstr "Habitación: %s"

msgid "da concordare con la casa"
msgstr "por acordar con la casa"

msgid "Tipo di soggiorno: %s"
msgstr "Tipo de estancia: %s"

msgid "Non siamo riusciti a inviare la richiesta. Scrivi direttamente a %s."
msgstr "No hemos podido enviar la solicitud. Escribe directamente a %s."

msgid "Ciao %s,"
msgstr "Hola, %s:"

msgid "abbiamo inoltrato la tua richiesta a %s. Ti risponderà direttamente la casa, con disponibilità e prezzi."
msgstr "hemos enviado tu solicitud a %s. La casa te responderá directamente con disponibilidad y precios."

msgid "Per aggiungere dettagli rispondi a questa email: arriverà a %1$s (%2$s)."
msgstr "Para añadir detalles, responde a este correo: llegará a %1$s (%2$s)."

msgid "Abbiamo inoltrato la tua richiesta a %s"
msgstr "Hemos enviado tu solicitud a %s"

msgid "Richiesta inviata a %1$s. Ti abbiamo mandato una copia a %2$s."
msgstr "Solicitud enviada a %1$s. Te hemos enviado una copia a %2$s."

msgid "Lascia vuoto questo campo"
msgstr "Deja este campo vacío"

msgid "Richiedi un soggiorno"
msgstr "Solicitar una estancia"

msgid "Senza impegno: la casa ti risponde con disponibilità e prezzi."
msgstr "Sin compromiso: la casa te responde con disponibilidad y precios."

msgid "Arrivo"
msgstr "Llegada"

msgid "Partenza"
msgstr "Salida"

msgid "Partecipanti"
msgstr "Participantes"

msgid "Adulti"
msgstr "Adultos"

msgid "Un adulto in meno"
msgstr "Un adulto menos"

msgid "Un adulto in più"
msgstr "Un adulto más"

msgid "Bambini"
msgstr "Niños"

msgid "Un bambino in meno"
msgstr "Un niño menos"

msgid "Un bambino in più"
msgstr "Un niño más"

msgid "Tipologia di camera"
msgstr "Tipo de habitación"

msgid "Da concordare con la casa"
msgstr "Por acordar con la casa"

msgid "Più tipologie (gruppo)"
msgstr "Varios tipos (grupo)"

msgid "Camera singola"
msgstr "Habitación individual"

msgid "Camera doppia"
msgstr "Habitación doble"

msgid "Camera per famiglia"
msgstr "Habitación familiar"

msgid "Più camere (gruppo)"
msgstr "Varias habitaciones (grupo)"

msgid "Tipo di soggiorno"
msgstr "Tipo de estancia"

msgid "Nome e cognome"
msgstr "Nombre y apellidos"

msgid "Email"
msgstr "Correo electrónico"

msgid "Telefono"
msgstr "Teléfono"

msgid "(facoltativo)"
msgstr "(opcional)"

msgid "Messaggio"
msgstr "Mensaje"

msgid "Esigenze particolari, orario di arrivo, pasti…"
msgstr "Necesidades especiales, hora de llegada, comidas…"

msgid "Ho letto l’%s e acconsento al trattamento dei dati per rispondere alla richiesta."
msgstr "He leído la %s y acepto el tratamiento de mis datos para responder a la solicitud."

msgid "informativa privacy"
msgstr "política de privacidad"

msgid "Acconsento al trattamento dei dati per rispondere alla richiesta: li riceve solo la casa scelta."
msgstr "Acepto el tratamiento de mis datos para responder a la solicitud: solo los recibe la casa elegida."

msgid "La richiesta non è partita: controlla i campi e riprova."
msgstr "La solicitud no se ha enviado: revisa los campos y vuelve a intentarlo."

msgid "Invia la richiesta"
msgstr "Enviar solicitud"

msgid "La richiesta arriva a %s."
msgstr "La solicitud llega a %s."

msgid "Richiesta inviata"
msgstr "Solicitud enviada"

msgid "La tua richiesta è arrivata a %s: ti risponderà direttamente la casa. Ti abbiamo mandato una copia via email."
msgstr "Tu solicitud ha llegado a %s: la casa te responderá directamente. Te hemos enviado una copia por correo."

msgid "Invia un’altra richiesta"
msgstr "Enviar otra solicitud"
