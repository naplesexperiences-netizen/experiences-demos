msgstr "Un adulte de moins"

msgid "Un adulto in più"
msgstr "Un adulte de plus"

msgid "Bambini"
msgstr "Enfants"

msgid "Un bambino in meno"
msgstr "Un enfant de moins"

msgid "Un bambino in più"
msgstr "Un enfant de plus"

msgid "Tipologia di camera"
msgstr "Type de chambre"

msgid "Da concordare con la casa"
msgstr "À convenir avec la maison"

msgid "Più tipologie (gruppo)"
msgstr "Plusieurs types (groupe)"

msgid "Camera singola"
msgstr "Chambre simple"

msgid "Camera doppia"
msgstr "Chambre double"

msgid "Camera per famiglia"
msgstr "Chambre familiale"

msgid "Più camere (gruppo)"
msgstr "Plusieurs chambres (groupe)"

msgid "Tipo di soggiorno"
msgstr "Type de séjour"

