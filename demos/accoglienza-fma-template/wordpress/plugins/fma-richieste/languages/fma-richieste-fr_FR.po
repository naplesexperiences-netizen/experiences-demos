msgid "Vacanza"
msgstr "Vacances"

msgid "Famiglia"
msgstr "Famille"

msgid "Gruppo o parrocchia"
msgstr "Groupe ou paroisse"

msgid "Ritiro spirituale"
msgstr "Retraite spirituelle"

msgctxt "formato data email"
msgid "j F Y"
msgstr "j F Y"

msgid "Scegli la data di arrivo."
msgstr "Choisissez la date d’arrivée."

msgid "La data di arrivo è già passata."
msgstr "La date d’arrivée est déjà passée."

msgid "Scegli la data di partenza."
msgstr "Choisissez la date de départ."

msgid "La partenza deve essere dopo l’arrivo."
msgstr "Le départ doit être postérieur à l’arrivée."

msgid "Per soggiorni oltre 120 notti scrivi direttamente alla casa."
msgstr "Pour les séjours de plus de 120 nuits, écrivez directement à la maison."

msgid "Indica da 1 a 120 adulti."
msgstr "Indiquez de 1 à 120 adultes."

msgid "Indica da 0 a 60 bambini."
msgstr "Indiquez de 0 à 60 enfants."

msgid "Scrivi nome e cognome."
msgstr "Indiquez vos nom et prénom."

msgid "Controlla l’indirizzo email (es. nome@esempio.it)."
msgstr "Vérifiez l’adresse e-mail (ex. nom@exemple.fr)."

msgid "Serve il consenso per inviare la richiesta."
msgstr "Votre consentement est nécessaire pour envoyer la demande."

msgid "Richiesta inviata."
msgstr "Demande envoyée."

msgid "Hai inviato molte richieste in poco tempo. Riprova tra qualche minuto o scrivi direttamente alla casa."
msgstr "Vous avez envoyé beaucoup de demandes en peu de temps. Réessayez dans quelques minutes ou écrivez directement à la maison."

msgid "Struttura non trovata. Ricarica la pagina e riprova."
msgstr "Maison introuvable. Rechargez la page et réessayez."

msgid "Questa casa non riceve ancora richieste dal sito: usa i recapiti indicati nella pagina."
msgstr "Cette maison ne reçoit pas encore de demandes via le site : utilisez les coordonnées indiquées sur la page."

msgid "Manca un’informazione: la trovi evidenziata."
msgstr "Il manque une information : elle est signalée."

msgid "Mancano %d informazioni: le trovi evidenziate."
msgstr "Il manque %d informations : elles sont signalées."

msgid "%d adulto"
msgid_plural "%d adulti"
msgstr[0] "%d adulte"
msgstr[1] "%d adultes"

msgid "%d bambino"
msgid_plural "%d bambini"
msgstr[0] "%d enfant"
msgstr[1] "%d enfants"

msgid "%d notte"
msgid_plural "%d notti"
msgstr[0] "%d nuit"
msgstr[1] "%d nuits"

msgid "Struttura: %s"
msgstr "Maison : %s"

msgid "Date: %s"
msgstr "Dates : %s"

msgid "Partecipanti: %s"
msgstr "Participants : %s"

msgid "Camera: %s"
msgstr "Chambre : %s"

msgid "da concordare con la casa"
msgstr "à convenir avec la maison"

msgid "Tipo di soggiorno: %s"
msgstr "Type de séjour : %s"

msgid "Non siamo riusciti a inviare la richiesta. Scrivi direttamente a %s."
msgstr "Nous n’avons pas pu envoyer votre demande. Écrivez directement à %s."

msgid "Ciao %s,"
msgstr "Bonjour %s,"

msgid "abbiamo inoltrato la tua richiesta a %s. Ti risponderà direttamente la casa, con disponibilità e prezzi."
msgstr "nous avons transmis votre demande à %s. La maison vous répondra directement avec ses disponibilités et ses prix."

msgid "Per aggiungere dettagli rispondi a questa email: arriverà a %1$s (%2$s)."
msgstr "Pour ajouter des précisions, répondez à cet e-mail : il arrivera à %1$s (%2$s)."

msgid "Abbiamo inoltrato la tua richiesta a %s"
msgstr "Nous avons transmis votre demande à %s"

msgid "Richiesta inviata a %1$s. Ti abbiamo mandato una copia a %2$s."
msgstr "Demande envoyée à %1$s. Nous vous avons envoyé une copie à %2$s."

msgid "Lascia vuoto questo campo"
msgstr "Laissez ce champ vide"

msgid "Richiedi un soggiorno"
msgstr "Demander un séjour"

msgid "Senza impegno: la casa ti risponde con disponibilità e prezzi."
msgstr "Sans engagement : la maison vous répond avec ses disponibilités et ses prix."

msgid "Arrivo"
msgstr "Arrivée"

msgid "Partenza"
msgstr "Départ"

msgid "Partecipanti"
msgstr "Participants"

