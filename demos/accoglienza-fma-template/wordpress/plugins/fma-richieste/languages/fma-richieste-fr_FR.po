msgstr "Téléphone"

msgid "(facoltativo)"
msgstr "(facultatif)"

msgid "Messaggio"
msgstr "Message"

msgid "Esigenze particolari, orario di arrivo, pasti…"
msgstr "Besoins particuliers, heure d’arrivée, repas…"

msgid "Ho letto l’%s e acconsento al trattamento dei dati per rispondere alla richiesta."
msgstr "J’ai lu la %s et j’accepte le traitement de mes données pour répondre à ma demande."

msgid "informativa privacy"
msgstr "politique de confidentialité"

msgid "Acconsento al trattamento dei dati per rispondere alla richiesta: li riceve solo la casa scelta."
msgstr "J’accepte le traitement de mes données pour répondre à ma demande : seule la maison choisie les reçoit."

msgid "La richiesta non è partita: controlla i campi e riprova."
msgstr "La demande n’a pas été envoyée : vérifiez les champs et réessayez."

msgid "Invia la richiesta"
msgstr "Envoyer la demande"

msgid "La richiesta arriva a %s."
msgstr "La demande arrive à %s."

msgid "Richiesta inviata"
msgstr "Demande envoyée"

msgid "La tua richiesta è arrivata a %s: ti risponderà direttamente la casa. Ti abbiamo mandato una copia via email."
msgstr "Votre demande est arrivée à %s : la maison vous répondra directement. Nous vous avons envoyé une copie par e-mail."

msgid "Invia un’altra richiesta"
msgstr "Envoyer une autre demande"
