msgid "Vacanza"
msgstr "Férias"

msgid "Famiglia"
msgstr "Família"

msgid "Gruppo o parrocchia"
msgstr "Grupo ou paróquia"

msgid "Ritiro spirituale"
msgstr "Retiro espiritual"

msgctxt "formato data email"
msgid "j F Y"
msgstr "j \\d\\e F \\d\\e Y"

msgid "Scegli la data di arrivo."
msgstr "Escolha a data de chegada."

msgid "La data di arrivo è già passata."
msgstr "A data de chegada já passou."

msgid "Scegli la data di partenza."
msgstr "Escolha a data de partida."

msgid "La partenza deve essere dopo l’arrivo."
msgstr "A partida tem de ser depois da chegada."

msgid "Per soggiorni oltre 120 notti scrivi direttamente alla casa."
msgstr "Para estadias de mais de 120 noites, escreva diretamente à casa."

msgid "Indica da 1 a 120 adulti."
msgstr "Indique entre 1 e 120 adultos."

msgid "Indica da 0 a 60 bambini."
msgstr "Indique entre 0 e 60 crianças."

msgid "Scrivi nome e cognome."
msgstr "Escreva o nome e apelido."

msgid "Controlla l’indirizzo email (es. nome@esempio.it)."
msgstr "Verifique o endereço de e-mail (ex.: nome@exemplo.pt)."

msgid "Serve il consenso per inviare la richiesta."
msgstr "É necessário o seu consentimento para enviar o pedido."

msgid "Richiesta inviata."
msgstr "Pedido enviado."

msgid "Hai inviato molte richieste in poco tempo. Riprova tra qualche minuto o scrivi direttamente alla casa."
msgstr "Enviou muitos pedidos em pouco tempo. Tente novamente dentro de alguns minutos ou escreva diretamente à casa."

msgid "Struttura non trovata. Ricarica la pagina e riprova."
msgstr "Casa não encontrada. Recarregue a página e tente novamente."

msgid "Questa casa non riceve ancora richieste dal sito: usa i recapiti indicati nella pagina."
msgstr "Esta casa ainda não recebe pedidos através do site: use os contactos indicados na página."

msgid "Manca un’informazione: la trovi evidenziata."
msgstr "Falta uma informação: está assinalada."

msgid "Mancano %d informazioni: le trovi evidenziate."
msgstr "Faltam %d informações: estão assinaladas."

msgid "%d adulto"
msgid_plural "%d adulti"
msgstr[0] "%d adulto"
msgstr[1] "%d adultos"

msgid "%d bambino"
msgid_plural "%d bambini"
msgstr[0] "%d criança"
msgstr[1] "%d crianças"

msgid "%d notte"
msgid_plural "%d notti"
msgstr[0] "%d noite"
msgstr[1] "%d noites"

msgid "Struttura: %s"
msgstr "Casa: %s"

msgid "Date: %s"
msgstr "Datas: %s"

msgid "Partecipanti: %s"
msgstr "Participantes: %s"

msgid "Camera: %s"
msgstr "Quarto: %s"

msgid "da concordare con la casa"
msgstr "a combinar com a casa"

msgid "Tipo di soggiorno: %s"
msgstr "Tipo de estadia: %s"

msgid "Non siamo riusciti a inviare la richiesta. Scrivi direttamente a %s."
msgstr "Não conseguimos enviar o pedido. Escreva diretamente para %s."

msgid "Ciao %s,"
msgstr "Olá, %s,"

msgid "abbiamo inoltrato la tua richiesta a %s. Ti risponderà direttamente la casa, con disponibilità e prezzi."
msgstr "encaminhámos o seu pedido para %s. A casa irá responder-lhe diretamente com disponibilidade e preços."

msgid "Per aggiungere dettagli rispondi a questa email: arriverà a %1$s (%2$s)."
msgstr "Para acrescentar pormenores, responda a este e-mail: chegará a %1$s (%2$s)."

msgid "Abbiamo inoltrato la tua richiesta a %s"
msgstr "Encaminhámos o seu pedido para %s"

msgid "Richiesta inviata a %1$s. Ti abbiamo mandato una copia a %2$s."
msgstr "Pedido enviado para %1$s. Enviámos-lhe uma cópia para %2$s."

msgid "Lascia vuoto questo campo"
msgstr "Deixe este campo em branco"

msgid "Richiedi un soggiorno"
msgstr "Pedir uma estadia"

msgid "Senza impegno: la casa ti risponde con disponibilità e prezzi."
msgstr "Sem compromisso: a casa responde-lhe com disponibilidade e preços."

msgid "Arrivo"
msgstr "Chegada"

msgid "Partenza"
msgstr "Partida"

msgid "Partecipanti"
msgstr "Participantes"

msgid "Adulti"
msgstr "Adultos"

msgid "Un adulto in meno"
msgstr "Menos um adulto"

msgid "Un adulto in più"
msgstr "Mais um adulto"

msgid "Bambini"
msgstr "Crianças"

msgid "Un bambino in meno"
msgstr "Menos uma criança"

msgid "Un bambino in più"
msgstr "Mais uma criança"

msgid "Tipologia di camera"
msgstr "Tipo de quarto"

msgid "Da concordare con la casa"
msgstr "A combinar com a casa"

msgid "Più tipologie (gruppo)"
msgstr "Vários tipos (grupo)"

msgid "Camera singola"
msgstr "Quarto individual"

msgid "Camera doppia"
msgstr "Quarto duplo"

msgid "Camera per famiglia"
msgstr "Quarto familiar"

msgid "Più camere (gruppo)"
msgstr "Vários quartos (grupo)"

msgid "Tipo di soggiorno"
msgstr "Tipo de estadia"

msgid "Nome e cognome"
msgstr "Nome e apelido"

msgid "Email"
msgstr "E-mail"

msgid "Telefono"
msgstr "Telefone"

msgid "(facoltativo)"
msgstr "(opcional)"

msgid "Messaggio"
msgstr "Mensagem"

msgid "Esigenze particolari, orario di arrivo, pasti…"
msgstr "Necessidades especiais, hora de chegada, refeições…"

msgid "Ho letto l’%s e acconsento al trattamento dei dati per rispondere alla richiesta."
msgstr "Li a %s e autorizo o tratamento dos meus dados para responder ao pedido."

msgid "informativa privacy"
msgstr "política de privacidade"

msgid "Acconsento al trattamento dei dati per rispondere alla richiesta: li riceve solo la casa scelta."
msgstr "Autorizo o tratamento dos meus dados para responder ao pedido: só a casa escolhida os recebe."

msgid "La richiesta non è partita: controlla i campi e riprova."
msgstr "O pedido não foi enviado: verifique os campos e tente novamente."

msgid "Invia la richiesta"
msgstr "Enviar pedido"

msgid "La richiesta arriva a %s."
msgstr "O pedido chega a %s."

msgid "Richiesta inviata"
msgstr "Pedido enviado"

msgid "La tua richiesta è arrivata a %s: ti risponderà direttamente la casa. Ti abbiamo mandato una copia via email."
msgstr "O seu pedido chegou a %s: a casa irá responder-lhe diretamente. Enviámos-lhe uma cópia por e-mail."

msgid "Invia un’altra richiesta"
msgstr "Enviar outro pedido"
