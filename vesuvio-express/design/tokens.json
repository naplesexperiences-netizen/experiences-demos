{
  "$description": "Vesuvio Express 2027 — design token (formato DTCG). Fonte unica: tokens.css e il tema Tailwind derivano da qui.",
  "color": {
    "$type": "color",
    "basalto":   { "$value": "#231F1C", "$description": "Pietra lavica. Testo principale, superfici scure, linea del percorso." },
    "basalto-2": { "$value": "#3A3430", "$description": "Basalto rialzato: superfici scure secondarie, footer." },
    "pomice":    { "$value": "#6B635C", "$description": "Pomice. Testo secondario (4.9:1 su cenere)." },
    "cenere":    { "$value": "#EEEAE3", "$description": "Cenere. Sfondo pagina." },
    "cenere-2":  { "$value": "#DDD6CB", "$description": "Cenere compatta. Divisori, superfici secondarie, bordi." },
    "carta":     { "$value": "#F7F5F1", "$description": "Superficie di schede, campi, widget di prenotazione." },
    "scoria":    { "$value": "#A93F24", "$description": "Scoria ossidata. SOLO azioni di prenotazione (6.1:1 con bianco)." },
    "scoria-scura": { "$value": "#8E331C", "$description": "Hover/pressed dell'azione. Anche errori di form." },
    "leccio":    { "$value": "#3D5A3A", "$description": "Leccio della macchia mediterranea. Stato «aperto», conferme." },
    "ginestra":  { "$value": "#E6B422", "$description": "Ginestra del Vesuvio. Avvisi (vento, chiusure) e accento su fondo scuro. Mai testo su chiaro." },
    "golfo":     { "$value": "#1D4F6E", "$description": "Blu del Golfo visto dal cratere. Link, informazioni, acqua nelle mappe." },
    "bianco":    { "$value": "#FFFFFF" }
  },
  "semantic": {
    "$type": "color",
    "bg":            { "$value": "{color.cenere}" },
    "surface":       { "$value": "{color.carta}" },
    "surface-dark":  { "$value": "{color.basalto}" },
    "text":          { "$value": "{color.basalto}" },
    "text-muted":    { "$value": "{color.pomice}" },
    "text-on-dark":  { "$value": "{color.cenere}" },
    "border":        { "$value": "{color.cenere-2}" },
    "border-strong": { "$value": "{color.basalto}" },
    "action":        { "$value": "{color.scoria}" },
    "action-hover":  { "$value": "{color.scoria-scura}" },
    "on-action":     { "$value": "{color.bianco}" },
    "link":          { "$value": "{color.golfo}" },
    "status-open":   { "$value": "{color.leccio}" },
    "status-warn":   { "$value": "{color.ginestra}" },
    "error":         { "$value": "{color.scoria-scura}" },
    "focus":         { "$value": "{color.golfo}" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Archivo", "Noto Sans", "system-ui", "sans-serif"], "$description": "Titoli, prezzi, orari. Asse wdth 87 (semi-condensato), cifre tabellari." },
    "body":    { "$value": ["Atkinson Hyperlegible Next", "Noto Sans", "system-ui", "sans-serif"], "$description": "Testo e interfaccia." },
    "ja":      { "$value": ["Noto Sans JP", "Hiragino Sans", "Yu Gothic", "sans-serif"] },
    "zh":      { "$value": ["Noto Sans SC", "PingFang SC", "Microsoft YaHei", "sans-serif"] },
    "ar":      { "$value": ["Noto Sans Arabic", "Geeza Pro", "Tahoma", "sans-serif"] }
  },
  "text": {
    "$description": "Dimensioni in px: mobile (360) → desktop (≥1200), interpolate con clamp().",
    "display": { "size": [40, 72], "lineHeight": 1.04, "weight": 700, "family": "display", "tracking": "-0.01em" },
    "h1":      { "size": [32, 48], "lineHeight": 1.1,  "weight": 700, "family": "display" },
    "h2":      { "size": [26, 36], "lineHeight": 1.15, "weight": 600, "family": "display" },
    "h3":      { "size": [20, 24], "lineHeight": 1.25, "weight": 600, "family": "display" },
    "data":    { "size": [28, 32], "lineHeight": 1.1,  "weight": 600, "family": "display", "features": "tnum" },
    "body-l":  { "size": [18, 20], "lineHeight": 1.5,  "weight": 400, "family": "body" },
    "body":    { "size": [17, 17], "lineHeight": 1.5,  "weight": 400, "family": "body" },
    "ui":      { "size": [16, 16], "lineHeight": 1.3,  "weight": 600, "family": "body" },
    "small":   { "size": [14, 14], "lineHeight": 1.45, "weight": 400, "family": "body" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },  "2": { "$value": "8px" },  "3": { "$value": "12px" },
    "4": { "$value": "16px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" },
    "12": { "$value": "48px" }, "16": { "$value": "64px" }, "24": { "$value": "96px" }, "32": { "$value": "128px" }
  },
  "radius": {
    "$type": "dimension",
    "s": { "$value": "4px", "$description": "Campi, bottoni" },
    "m": { "$value": "8px", "$description": "Schede, widget" },
    "pill": { "$value": "999px", "$description": "Solo chip di stato" }
  },
  "size": {
    "$type": "dimension",
    "touch": { "$value": "48px", "$description": "Area minima di tocco" },
    "container": { "$value": "1200px" },
    "measure": { "$value": "68ch" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "600px" }, "md": { "$value": "900px" }, "lg": { "$value": "1200px" }
  },
  "motion": {
    "duration-fast": { "$type": "duration", "$value": "150ms" },
    "duration-base": { "$type": "duration", "$value": "250ms" },
    "ease-out": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] }
  },
  "shadow": {
    "sticky": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "-2px", "blur": "12px", "spread": "0px", "color": "#231F1C29" }, "$description": "Unica ombra del sistema: barra di prenotazione sticky." }
  }
}
